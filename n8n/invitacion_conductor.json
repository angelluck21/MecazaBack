              "id": "email_html",
              "name": "email_html",
              "value": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Acceso como Conductor - Mecaza</title>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #f4f6f9; font-family: 'Segoe UI', Arial, sans-serif;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color: #f4f6f9; padding: 32px 0;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.08);\">\n          <tr>\n            <td style=\"background: linear-gradient(135deg, #1a3a5c 0%, #2563a8 100%); padding: 40px 48px; text-align: center;\">\n              <p style=\"margin: 0 0 8px 0; font-size: 13px; font-weight: 600; letter-spacing: 3px; color: #7eb8f7; text-transform: uppercase;\">PLATAFORMA DE CONDUCTORES</p>\n              <h1 style=\"margin: 0; font-size: 32px; font-weight: 800; color: #ffffff; letter-spacing: 2px;\">MECAZA</h1>\n              <div style=\"margin: 20px auto 0; width: 48px; height: 3px; background-color: #f0b429; border-radius: 2px;\"></div>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 40px 48px;\">\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; color: #374151;\">Hola,</p>\n              <p style=\"margin: 0 0 16px 0; font-size: 15px; line-height: 1.7; color: #4b5563;\">\n                Has sido invitado a unirte a <strong style=\"color: #1a3a5c;\">Mecaza</strong> como <strong style=\"color: #1a3a5c;\">conductor</strong>. Para activar tu acceso a la plataforma, completa tu registro usando el enlace exclusivo a continuación.\n              </p>\n              <p style=\"margin: 0 0 24px 0; font-size: 15px; line-height: 1.7; color: #4b5563;\">\n                Este enlace es <strong style=\"color: #1a3a5c;\">personal e intransferible</strong> y te llevará a la página de registro para conductores, a la cual solo se puede acceder mediante esta invitación.\n              </p>\n              <div style=\"border-top: 1px solid #e5e7eb; margin: 0 0 24px 0;\"></div>\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin: 28px 0;\">\n                <tr>\n                  <td align=\"center\">\n                    <a href=\"{{ $json.body.link }}\" target=\"_blank\" style=\"display: inline-block; background: linear-gradient(135deg, #2563a8 0%, #1a3a5c 100%); color: #ffffff; text-decoration: none; font-size: 16px; font-weight: 700; padding: 16px 40px; border-radius: 8px; letter-spacing: 0.5px; box-shadow: 0 4px 12px rgba(37,99,168,0.35);\">\n                      Registrarme como Conductor\n                    </a>\n                  </td>\n                </tr>\n              </table>\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                  <td style=\"background-color: #fffbeb; border-left: 4px solid #f0b429; border-radius: 0 8px 8px 0; padding: 14px 18px;\">\n                    <p style=\"margin: 0; font-size: 14px; color: #92400e;\">\n                      <strong>Importante:</strong> Este enlace es válido por <strong>48 horas</strong>. Si no te registras antes de que expire, deberás solicitar una nueva invitación.\n                    </p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"background-color: #f8fafc; border-top: 1px solid #e5e7eb; padding: 24px 48px; text-align: center;\">\n              <p style=\"margin: 0 0 4px 0; font-size: 14px; font-weight: 700; color: #1a3a5c;\">Mecaza</p>\n              <p style=\"margin: 0; font-size: 12px; color: #9ca3af;\">Este es un correo automático, por favor no respondas a este mensaje.</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
              "type": "string"
            }
          ]
        },
